<section class="contact-hero">
  <div class="contact-hero__image" aria-hidden="true"></div>
  <div class="contact-hero__overlay" aria-hidden="true"></div>

  <div class="contact-hero__inner">

    <p class="contact-hero__kicker">
      Conseil luminaires & éclairage
    </p>

    <h1 class="contact-hero__title">
      Contactez<br>
      Lumière Maison
    </h1>

    <p class="contact-hero__text">
      Une question sur un luminaire, une commande ou le choix d’un éclairage ?
      Nous vous aidons à trouver la solution adaptée à votre intérieur,
      votre extérieur ou votre projet d’aménagement.
    </p>

  </div>
</section>


<section class="contact-section">

  <div class="contact-container">

    <div class="contact-grid">

      <div class="contact-card">

        <p class="contact-card__kicker">
          Envoyer un message
        </p>

        <h2 class="contact-card__title">
          Parlons de votre besoin
        </h2>

        <p class="contact-card__text">
          Suspension, applique, éclairage LED, extérieur ou conseil déco :
          utilisez le formulaire ci-dessous pour nous contacter directement.
        </p>

        <%= form_with url: contact_path, method: :post, local: true, class:"contact-form" do |f| %>

          <div class="contact-field">
            <%= f.label :name, "Nom", class:"contact-label" %>
            <%= f.text_field :name,
                  class:"contact-input",
                  placeholder:"Votre nom",
                  required:true %>
          </div>

          <div class="contact-field">
            <%= f.label :email, "Adresse e-mail", class:"contact-label" %>
            <%= f.email_field :email,
                  class:"contact-input",
                  placeholder:"Votre adresse e-mail",
                  required:true %>
          </div>

          <div class="contact-field">
            <%= f.label :message, "Votre message", class:"contact-label" %>
            <%= f.text_area :message,
                  rows:7,
                  class:"contact-textarea",
                  placeholder:"Parlez-nous de votre demande...",
                  required:true %>
          </div>

          <div class="contact-actions">
            <%= f.submit "Envoyer le message", class:"contact-button" %>
          </div>

        <% end %>

      </div>


      <div class="contact-info">

        <div class="contact-info__card">

          <p class="contact-info__kicker">
            Informations boutique
          </p>

          <h2 class="contact-info__title">
            Lumière Maison
          </h2>

          <p class="contact-info__text">
            Boutique spécialisée dans les luminaires décoratifs,
            l’éclairage LED et les solutions lumineuses pour la maison,
            les terrasses, les façades et les espaces professionnels.
          </p>

          <ul class="contact-info__list">

            <li>
              <strong>Spécialité :</strong><br>
              Luminaires & éclairage décoratif
            </li>

            <li>
              <strong>Univers :</strong><br>
              Intérieur, extérieur, LED & décoration
            </li>

            <li>
              <strong>Téléphone :</strong><br>
              06 37 58 18 23
            </li>

            <li>
              <strong>Instagram :</strong><br>
              @lumiere_maison
            </li>

          </ul>

          <div class="contact-info__links">

            <%= link_to "Découvrir la boutique",
                  products_path,
                  class:"contact-link" %>

            <%= link_to "Voir les offres",
                  offers_path,
                  class:"contact-link" %>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>


<section class="contact-reassurance">

  <div class="contact-reassurance__inner">

    <div class="contact-reassurance__item">
      <span>01</span>

      <h3>Réponse rapide</h3>

      <p>
        Chaque message est traité avec attention afin de vous orienter
        vers le luminaire ou la solution d’éclairage adaptée.
      </p>
    </div>

    <div class="contact-reassurance__item">
      <span>02</span>

      <h3>Conseil personnalisé</h3>

      <p>
        Nous vous aidons à choisir selon votre pièce, votre ambiance,
        votre usage et votre style de décoration.
      </p>
    </div>

    <div class="contact-reassurance__item">
      <span>03</span>

      <h3>Sélection lumineuse</h3>

      <p>
        Suspensions, appliques, lampes, spots, rubans LED
        et éclairages extérieurs pour tous les besoins.
      </p>
    </div>

  </div>

</section>
