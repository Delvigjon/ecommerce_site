<section class="contact-hero">

  <div class="contact-hero__image" aria-hidden="true"></div>
  <div class="contact-hero__overlay" aria-hidden="true"></div>

  <div class="contact-hero__inner">

    <p class="contact-hero__kicker">
      Maison Lumière
    </p>

    <h1 class="contact-hero__title">
      Parlons<br>
      lumière
    </h1>

    <p class="contact-hero__text">
      Une question sur une pièce, une commande ou l’éclairage
      d’un espace ? Échangeons autour de votre besoin.
    </p>

  </div>

</section>


<section class="contact-section">

  <div class="contact-container">

    <div class="contact-grid">

      <!-- =================================================
           FORMULAIRE
      ================================================== -->

      <div class="contact-card">

        <p class="contact-card__kicker">
          01 / Votre message
        </p>

        <h2 class="contact-card__title">
          Échanger avec<br>
          la Maison
        </h2>

        <p class="contact-card__text">
          Décrivez-nous votre besoin, votre pièce ou le luminaire
          que vous recherchez. Nous reviendrons vers vous avec
          une réponse adaptée.
        </p>


        <%= form_with(
          url: contact_path,
          method: :post,
          local: true,
          class: "contact-form"
        ) do |f| %>

          <div class="contact-field">

            <%= f.label :name,
                "Nom",
                class: "contact-label" %>

            <%= f.text_field :name,
                class: "contact-input",
                placeholder: "Votre nom",
                required: true %>

          </div>


          <div class="contact-field">

            <%= f.label :email,
                "Adresse e-mail",
                class: "contact-label" %>

            <%= f.email_field :email,
                class: "contact-input",
                placeholder: "votre@email.fr",
                required: true %>

          </div>


          <div class="contact-field">

            <%= f.label :message,
                "Votre message",
                class: "contact-label" %>

            <%= f.text_area :message,
                rows: 7,
                class: "contact-textarea",
                placeholder: "Parlez-nous de votre projet ou de votre demande...",
                required: true %>

          </div>


          <div class="contact-actions">

            <%= f.submit(
              "Envoyer le message",
              class: "contact-button"
            ) %>

          </div>

        <% end %>

      </div>


      <!-- =================================================
           INFOS
      ================================================== -->

      <aside class="contact-info">

        <div class="contact-info__visual">

          <div class="contact-info__image"></div>

        </div>


        <div class="contact-info__content">

          <p class="contact-info__kicker">
            02 / Maison Lumière
          </p>

          <h2 class="contact-info__title">
            Une question,<br>
            un projet ?
          </h2>

          <p class="contact-info__text">
            Nous vous accompagnons dans le choix de luminaires
            adaptés à votre intérieur, votre extérieur
            ou votre projet d’aménagement.
          </p>


          <dl class="contact-info__list">

            <div>
              <dt>
                Téléphone
              </dt>

              <dd>
                06 37 58 18 23
              </dd>
            </div>


            <div>
              <dt>
                Instagram
              </dt>

              <dd>
                @lumiere_maison
              </dd>
            </div>


            <div>
              <dt>
                Univers
              </dt>

              <dd>
                Intérieur · Extérieur · LED · Décoration
              </dd>
            </div>

          </dl>


          <div class="contact-info__links">

            <%= link_to(
              "Découvrir la collection →",
              products_path,
              class: "contact-link"
            ) %>

            <%= link_to(
              "Voir nos sélections →",
              offers_path,
              class: "contact-link"
            ) %>

          </div>

        </div>

      </aside>

    </div>

  </div>

</section>


<section class="contact-reassurance">

  <div class="contact-reassurance__inner">

    <article class="contact-reassurance__item">

      <span>
        01
      </span>

      <h3>
        Écoute
      </h3>

      <p>
        Chaque demande est étudiée pour comprendre
        votre besoin et votre espace.
      </p>

    </article>


    <article class="contact-reassurance__item">

      <span>
        02
      </span>

      <h3>
        Conseil
      </h3>

      <p>
        Nous vous aidons à trouver la lumière,
        la forme et l’usage les plus adaptés.
      </p>

    </article>


    <article class="contact-reassurance__item">

      <span>
        03
      </span>

      <h3>
        Sélection
      </h3>

      <p>
        Une collection pensée autour de la matière,
        de l’ambiance et du confort lumineux.
      </p>

    </article>

  </div>

</section>
