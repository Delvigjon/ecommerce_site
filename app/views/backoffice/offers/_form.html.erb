<%# app/views/backoffice/offers/_form.html.erb %>

<%= form_with(
  model: [:backoffice, offer],
  class: "backoffice-offer-form"
) do |f| %>

  <%# =====================================================
      ERRORS
  ===================================================== %>

  <% if offer.errors.any? %>

    <div class="backoffice-offer-form__errors">

      <p class="backoffice-offer-form__errors-title">
        Certaines informations doivent être corrigées.
      </p>

      <ul>

        <% offer.errors.full_messages.each do |message| %>

          <li>
            <%= message %>
          </li>

        <% end %>

      </ul>

    </div>

  <% end %>


  <%# =====================================================
      INFORMATIONS PRINCIPALES
  ===================================================== %>

  <section class="backoffice-offer-form__section">

    <header class="backoffice-offer-form__section-header">

      <p class="backoffice-offer-form__kicker">
        Offre
      </p>

      <h2 class="backoffice-offer-form__section-title">
        Informations principales
      </h2>

    </header>


    <div class="backoffice-offer-form__grid">

      <div class="
        backoffice-offer-form__field
        backoffice-offer-form__field--full
      ">

        <%= f.label(
          :name,
          "Nom de l'offre",
          class: "backoffice-offer-form__label"
        ) %>

        <%= f.text_field(
          :name,
          class: "backoffice-offer-form__input",
          placeholder: "Ex. Suspension + ampoule offerte"
        ) %>

      </div>


      <div class="
        backoffice-offer-form__field
        backoffice-offer-form__field--full
      ">

        <%= f.label(
          :description,
          "Description",
          class: "backoffice-offer-form__label"
        ) %>

        <%= f.text_area(
          :description,
          rows: 7,
          class: "backoffice-offer-form__textarea",
          placeholder: "Présentez l'offre, ses avantages et ses conditions..."
        ) %>

      </div>


      <div class="backoffice-offer-form__field">

        <%= f.label(
          :price,
          "Prix",
          class: "backoffice-offer-form__label"
        ) %>

        <div class="backoffice-offer-form__price-field">

          <%= f.number_field(
            :price,
            step: 0.01,
            min: 0,
            class: "backoffice-offer-form__input",
            placeholder: "0.00"
          ) %>

          <span>
            €
          </span>

        </div>

      </div>

    </div>

  </section>


  <%# =====================================================
      PRODUIT ASSOCIÉ
  ===================================================== %>

  <section class="backoffice-offer-form__section">

    <header class="backoffice-offer-form__section-header">

      <p class="backoffice-offer-form__kicker">
        Catalogue
      </p>

      <h2 class="backoffice-offer-form__section-title">
        Produit associé
      </h2>

    </header>


    <p class="backoffice-offer-form__section-help">
      Vous pouvez rattacher cette offre à un produit de la boutique.
    </p>


    <div class="backoffice-offer-form__grid">

      <div class="
        backoffice-offer-form__field
        backoffice-offer-form__field--full
      ">

        <%= f.label(
          :product_id,
          "Produit",
          class: "backoffice-offer-form__label"
        ) %>

        <%= f.collection_select(
          :product_id,
          Product.order(:name),
          :id,
          :name,
          {
            include_blank: "Aucun produit associé"
          },
          class: "backoffice-offer-form__select"
        ) %>

      </div>

    </div>

  </section>


  <%# =====================================================
      IMAGE
  ===================================================== %>

  <section class="backoffice-offer-form__section">

    <header class="backoffice-offer-form__section-header">

      <p class="backoffice-offer-form__kicker">
        Visuel
      </p>

      <h2 class="backoffice-offer-form__section-title">
        Image
      </h2>

    </header>


    <p class="backoffice-offer-form__section-help">
      Vous pouvez utiliser une URL externe ou le nom d'une image
      présente dans le dossier des offres.
    </p>


    <div class="backoffice-offer-form__grid">

      <div class="
        backoffice-offer-form__field
        backoffice-offer-form__field--full
      ">

        <%= f.label(
          :image_url,
          "Image de l'offre",
          class: "backoffice-offer-form__label"
        ) %>

        <%= f.text_field(
          :image_url,
          class: "backoffice-offer-form__input",
          placeholder: "https://... ou nom-image.webp"
        ) %>

      </div>


      <% if offer.image_url.present? %>

        <div class="
          backoffice-offer-form__preview
          backoffice-offer-form__field--full
        ">

          <p class="backoffice-offer-form__preview-label">
            Aperçu actuel
          </p>

          <%
            src = offer.image_url.to_s
            preview_src =
              src.start_with?("http://", "https://") ?
                src :
                "offers/#{src}"
          %>

          <%= image_tag(
            preview_src,
            alt: offer.name,
            class: "backoffice-offer-form__preview-image"
          ) %>

        </div>

      <% elsif offer.product&.image_url.present? %>

        <div class="
          backoffice-offer-form__preview
          backoffice-offer-form__field--full
        ">

          <p class="backoffice-offer-form__preview-label">
            Image du produit associé
          </p>

          <%= image_tag(
            offer.product.image_url,
            alt: offer.product.name,
            class: "backoffice-offer-form__preview-image"
          ) %>

        </div>

      <% end %>

    </div>

  </section>


  <%# =====================================================
      AUTEUR
  ===================================================== %>

  <section class="backoffice-offer-form__section">

    <header class="backoffice-offer-form__section-header">

      <p class="backoffice-offer-form__kicker">
        Administration
      </p>

      <h2 class="backoffice-offer-form__section-title">
        Auteur
      </h2>

    </header>


    <div class="backoffice-offer-form__grid">

      <div class="
        backoffice-offer-form__field
        backoffice-offer-form__field--full
      ">

        <%= f.label(
          :user_id,
          "Créée par",
          class: "backoffice-offer-form__label"
        ) %>

        <%= f.collection_select(
          :user_id,
          User.where(role: "admin").order(:email),
          :id,
          :email,
          {
            include_blank: "Aucun auteur"
          },
          class: "backoffice-offer-form__select"
        ) %>

      </div>

    </div>

  </section>


  <%# =====================================================
      ACTIONS
  ===================================================== %>

  <div class="backoffice-offer-form__actions">

    <%= link_to(
      offer.persisted? ?
        backoffice_offer_path(offer) :
        backoffice_offers_path,
      class: "backoffice-offer-form__button backoffice-offer-form__button--secondary"
    ) do %>

      Annuler

    <% end %>


    <%= f.submit(
      offer.persisted? ?
        "Enregistrer les modifications" :
        "Créer l'offre",
      class: "backoffice-offer-form__button backoffice-offer-form__button--primary"
    ) %>

  </div>

<% end %>
