<%= form_with(
  model: [:backoffice, product],
  class: "backoffice-product-form"
) do |f| %>

  <% if product.errors.any? %>

    <div class="backoffice-product-form__errors">

      <h2>
        <%= pluralize(product.errors.count, "erreur") %>
        empêchent l’enregistrement
      </h2>

      <ul>
        <% product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>

    </div>

  <% end %>


  <div class="backoffice-product-form__grid">

    <div class="backoffice-product-form__main">

      <div class="backoffice-product-form__field">
        <%= f.label :name,
                    "Nom du produit",
                    class: "backoffice-product-form__label" %>

        <%= f.text_field :name,
                         class: "backoffice-product-form__input",
                         placeholder: "Ex. Suspension Aura" %>
      </div>


      <div class="backoffice-product-form__field">
        <%= f.label :description,
                    "Description",
                    class: "backoffice-product-form__label" %>

        <%= f.text_area :description,
                        rows: 8,
                        class: "backoffice-product-form__textarea",
                        placeholder: "Décrivez le produit..." %>
      </div>


      <div class="backoffice-product-form__field">
        <%= f.label :image_url,
                    "Image",
                    class: "backoffice-product-form__label" %>

        <%= f.text_field :image_url,
                         class: "backoffice-product-form__input",
                         placeholder: "URL ou nom du fichier image" %>

        <p class="backoffice-product-form__help">
          Vous pouvez utiliser une URL complète ou le nom d’une image présente dans les assets produits.
        </p>
      </div>

    </div>


    <aside class="backoffice-product-form__side">

      <div class="backoffice-product-form__side-block">

        <h2>
          Informations commerciales
        </h2>


        <div class="backoffice-product-form__field">
          <%= f.label :price,
                      "Prix",
                      class: "backoffice-product-form__label" %>

          <div class="backoffice-product-form__price-field">

            <%= f.number_field :price,
                               step: 0.01,
                               min: 0,
                               class: "backoffice-product-form__input" %>

            <span>€</span>

          </div>
        </div>


        <div class="backoffice-product-form__field">
          <%= f.label :stock,
                      "Stock",
                      class: "backoffice-product-form__label" %>

          <%= f.number_field :stock,
                             min: 0,
                             step: 1,
                             class: "backoffice-product-form__input" %>
        </div>

      </div>


      <% if product.image_url.present? %>

        <div class="backoffice-product-form__preview">

          <span class="backoffice-product-form__preview-label">
            Aperçu
          </span>

          <% src = product.image_url.to_s %>

          <%= image_tag(
            src.start_with?("http://", "https://") ? src : "products/#{src}",
            alt: product.name.presence || "Aperçu produit",
            class: "backoffice-product-form__preview-image"
          ) %>

        </div>

      <% end %>

    </aside>

  </div>


  <div class="backoffice-product-form__actions">

    <%= link_to "Annuler",
                backoffice_products_path,
                class: "backoffice-product-form__cancel" %>

    <%= f.submit(
      product.persisted? ? "Enregistrer les modifications" : "Créer le produit",
      class: "backoffice-product-form__submit"
    ) %>

  </div>

<% end %>
