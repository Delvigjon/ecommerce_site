<%# app/views/backoffice/users/_form.html.erb %>

<%= form_with(
  model: [:backoffice, user],
  class: "backoffice-user-form"
) do |f| %>


  <%# =====================================================
      ERRORS
  ===================================================== %>

  <% if user.errors.any? %>

    <div class="backoffice-user-form__errors">

      <p class="backoffice-user-form__errors-title">
        Certaines informations doivent être corrigées.
      </p>

      <ul>

        <% user.errors.full_messages.each do |message| %>

          <li>
            <%= message %>
          </li>

        <% end %>

      </ul>

    </div>

  <% end %>


  <%# =====================================================
      IDENTITÉ
  ===================================================== %>

  <section class="backoffice-user-form__section">

    <header class="backoffice-user-form__section-header">

      <p class="backoffice-user-form__kicker">
        Identité
      </p>

      <h2 class="backoffice-user-form__section-title">
        Informations client
      </h2>

    </header>


    <div class="backoffice-user-form__grid">

      <div class="backoffice-user-form__field">

        <%= f.label(
          :first_name,
          "Prénom",
          class: "backoffice-user-form__label"
        ) %>

        <%= f.text_field(
          :first_name,
          autocomplete: "given-name",
          class: "backoffice-user-form__input"
        ) %>

      </div>


      <div class="backoffice-user-form__field">

        <%= f.label(
          :last_name,
          "Nom",
          class: "backoffice-user-form__label"
        ) %>

        <%= f.text_field(
          :last_name,
          autocomplete: "family-name",
          class: "backoffice-user-form__input"
        ) %>

      </div>


      <div class="
      backoffice-user-form__field
      backoffice-user-form__field--full
      ">

        <%= f.label(
          :email,
          "Adresse e-mail",
          class: "backoffice-user-form__label"
        ) %>

        <%= f.email_field(
          :email,
          autocomplete: "email",
          class: "backoffice-user-form__input"
        ) %>

      </div>


      <div class="
      backoffice-user-form__field
      backoffice-user-form__field--full
      ">

        <%= f.label(
          :phone,
          "Téléphone",
          class: "backoffice-user-form__label"
        ) %>

        <%= f.telephone_field(
          :phone,
          autocomplete: "tel",
          class: "backoffice-user-form__input"
        ) %>

      </div>

    </div>

  </section>


  <%# =====================================================
      TYPE DE COMPTE
  ===================================================== %>

  <section class="backoffice-user-form__section">

    <header class="backoffice-user-form__section-header">

      <p class="backoffice-user-form__kicker">
        Compte
      </p>

      <h2 class="backoffice-user-form__section-title">
        Type de client
      </h2>

    </header>


    <div class="backoffice-user-form__grid">

      <div class="backoffice-user-form__field">

        <%= f.label(
          :account_type,
          "Type de compte",
          class: "backoffice-user-form__label"
        ) %>

        <%= f.select(
          :account_type,
          [
            ["Particulier", "individual"],
            ["Professionnel", "business"]
          ],
          {},
          class: "backoffice-user-form__select"
        ) %>

      </div>


      <div class="backoffice-user-form__field">

        <%= f.label(
          :role,
          "Rôle",
          class: "backoffice-user-form__label"
        ) %>

        <%= f.select(
          :role,
          [
            ["Client", "customer"],
            ["Administrateur", "admin"]
          ],
          {},
          class: "backoffice-user-form__select"
        ) %>

        <p class="backoffice-user-form__help">
          Réservez le rôle administrateur aux personnes autorisées
          à accéder au back-office.
        </p>

      </div>

    </div>

  </section>


  <%# =====================================================
      SOCIÉTÉ
  ===================================================== %>

  <section class="backoffice-user-form__section">

    <header class="backoffice-user-form__section-header">

      <p class="backoffice-user-form__kicker">
        Professionnel
      </p>

      <h2 class="backoffice-user-form__section-title">
        Informations société
      </h2>

    </header>


    <div class="backoffice-user-form__grid">

      <div class="
      backoffice-user-form__field
      backoffice-user-form__field--full
      ">

        <%= f.label(
          :company_name,
          "Nom de la société",
          class: "backoffice-user-form__label"
        ) %>

        <%= f.text_field(
          :company_name,
          autocomplete: "organization",
          class: "backoffice-user-form__input"
        ) %>

      </div>


      <div class="
      backoffice-user-form__field
      backoffice-user-form__field--full
      ">

        <%= f.label(
          :siret,
          "Numéro SIRET",
          class: "backoffice-user-form__label"
        ) %>

        <%= f.text_field(
          :siret,
          inputmode: "numeric",
          maxlength: 14,
          class: "backoffice-user-form__input",
          placeholder: "14 chiffres"
        ) %>

      </div>

    </div>

  </section>


  <%# =====================================================
      ADDRESS
  ===================================================== %>

  <section class="backoffice-user-form__section">

    <header class="backoffice-user-form__section-header">

      <p class="backoffice-user-form__kicker">
        Livraison
      </p>

      <h2 class="backoffice-user-form__section-title">
        Adresse
      </h2>

    </header>


    <div class="backoffice-user-form__grid">

      <div class="
      backoffice-user-form__field
      backoffice-user-form__field--full
      ">

        <%= f.label(
          :address,
          "Adresse",
          class: "backoffice-user-form__label"
        ) %>

        <%= f.text_field(
          :address,
          autocomplete: "street-address",
          class: "backoffice-user-form__input",
          placeholder: "12 rue Saint-Jean"
        ) %>

      </div>


      <div class="backoffice-user-form__field">

        <%= f.label(
          :postal_code,
          "Code postal",
          class: "backoffice-user-form__label"
        ) %>

        <%= f.text_field(
          :postal_code,
          autocomplete: "postal-code",
          inputmode: "numeric",
          class: "backoffice-user-form__input"
        ) %>

      </div>


      <div class="backoffice-user-form__field">

        <%= f.label(
          :city,
          "Ville",
          class: "backoffice-user-form__label"
        ) %>

        <%= f.text_field(
          :city,
          autocomplete: "address-level2",
          class: "backoffice-user-form__input"
        ) %>

      </div>

    </div>

  </section>


  <%# =====================================================
      PASSWORD
  ===================================================== %>

  <section class="backoffice-user-form__section">

    <header class="backoffice-user-form__section-header">

      <p class="backoffice-user-form__kicker">
        Sécurité
      </p>

      <h2 class="backoffice-user-form__section-title">
        Mot de passe
      </h2>

    </header>


    <p class="backoffice-user-form__section-help">
      <% if user.persisted? %>


        Laissez les champs vides pour conserver le mot de passe actuel.


      <% else %>


        Définissez le mot de passe initial du compte client.


      <% end %>
    </p>


    <div class="backoffice-user-form__grid">

      <div class="backoffice-user-form__field">

        <%= f.label(
          :password,
          "Mot de passe",
          class: "backoffice-user-form__label"
        ) %>

        <%= f.password_field(
          :password,
          autocomplete: "new-password",
          class: "backoffice-user-form__input"
        ) %>

      </div>


      <div class="backoffice-user-form__field">

        <%= f.label(
          :password_confirmation,
          "Confirmation",
          class: "backoffice-user-form__label"
        ) %>

        <%= f.password_field(
          :password_confirmation,
          autocomplete: "new-password",
          class: "backoffice-user-form__input"
        ) %>

      </div>

    </div>

  </section>


  <%# =====================================================
      ACTIONS
  ===================================================== %>

  <div class="backoffice-user-form__actions">

    <%= link_to(
      user.persisted? ?
        backoffice_user_path(user) :
        backoffice_users_path,
      class: "backoffice-user-form__button backoffice-user-form__button--secondary"
    ) do %>

      Annuler

    <% end %>


    <%= f.submit(
      user.persisted? ?
        "Enregistrer les modifications" :
        "Créer le client",
      class: "backoffice-user-form__button backoffice-user-form__button--primary"
    ) %>

  </div>

<% end %>
