<section class="cart-page">

  <div class="cart-container">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="cart-header">

      <div>

        <p class="cart-kicker">
          Votre sélection
        </p>

        <h1 class="cart-title">
          Mon panier
        </h1>

      </div>

      <p class="cart-subtitle">
        Vérifiez les pièces sélectionnées avant
        de poursuivre votre commande.
      </p>

    </header>


    <% if @cart.cart_items.any? %>

      <%=
        # Prix catalogue considéré TTC
        nil
      %>

      <%
        tva_rate = 0.20

        total_ttc = @cart.cart_items.sum do |item|
          item.product.price.to_f * item.quantity
        end

        subtotal_ht = total_ttc / (1 + tva_rate)
        tva_total   = total_ttc - subtotal_ht
      %>


      <!-- =====================================================
           CART LAYOUT
      ====================================================== -->

      <div class="cart-layout">

        <!-- =================================================
             ITEMS
        ================================================== -->

        <div class="cart-main">

          <div class="cart-main__header">

            <span>
              <%= pluralize(@cart.cart_items.sum(&:quantity), "article") %>
            </span>

            <span>
              Prix TTC
            </span>

          </div>


          <div class="cart-items">

            <% @cart.cart_items.each_with_index do |item, index| %>

              <%
                unit_price_ttc = item.product.price.to_f
                line_total_ttc = unit_price_ttc * item.quantity
              %>

              <article class="cart-item">

                <!-- =========================================
                     INDEX
                ========================================== -->

                <span class="cart-item__index">
                  <%= format("%02d", index + 1) %>
                </span>


                <!-- =========================================
                     IMAGE
                ========================================== -->

                <%= link_to(
                  product_path(item.product),
                  class: "cart-item__media"
                ) do %>

                  <% if item.product.image_url.present? %>

                    <%= image_tag(
                      item.product.image_url,
                      alt: item.product.name,
                      class: "cart-item__image",
                      loading: "lazy"
                    ) %>

                  <% else %>

                    <div
                      class="cart-item__placeholder"
                      aria-hidden="true">
                    </div>

                  <% end %>

                <% end %>


                <!-- =========================================
                     PRODUCT INFO
                ========================================== -->

                <div class="cart-item__info">

                  <p class="cart-item__category">
                    Maison Lumière
                  </p>

                  <h2 class="cart-item__name">

                    <%= link_to(
                      item.product.name,
                      product_path(item.product)
                    ) %>

                  </h2>

                  <p class="cart-item__unit-price">
                    <%= number_to_currency(
                      unit_price_ttc,
                      unit: "€",
                      format: "%n %u"
                    ) %>
                    TTC / unité
                  </p>


                  <!-- =======================================
                       QUANTITY
                  ======================================== -->

                  <div class="cart-item__quantity">

                    <%= form_with(
                      url: cart_cart_item_path(@cart, item),
                      method: :patch,
                      local: true,
                      class: "cart-quantity-form"
                    ) do |f| %>

                      <%= f.label(
                        :quantity,
                        "Quantité",
                        class: "cart-quantity-label"
                      ) %>

                      <div class="cart-quantity-controls">

                        <%= f.number_field(
                          :quantity,
                          value: item.quantity,
                          min: 1,
                          max: item.product.stock,
                          class: "cart-qty-input"
                        ) %>

                        <%= f.submit(
                          "Mettre à jour",
                          class: "cart-update-button"
                        ) %>

                      </div>

                    <% end %>

                  </div>

                </div>


                <!-- =========================================
                     TOTAL / REMOVE
                ========================================== -->

                <div class="cart-item__aside">

                  <div class="cart-item__total">

                    <span>
                      Total
                    </span>

                    <strong>
                      <%= number_to_currency(
                        line_total_ttc,
                        unit: "€",
                        format: "%n %u"
                      ) %>
                    </strong>

                  </div>


                  <div class="cart-item__remove">

                    <%= button_to(
                      "Retirer",
                      cart_cart_item_path(@cart, item),
                      method: :delete,
                      form: {
                        data: {
                          turbo_confirm: "Supprimer cet article ?"
                        }
                      },
                      class: "cart-remove-button"
                    ) %>

                  </div>

                </div>

              </article>

            <% end %>

          </div>

        </div>


        <!-- =================================================
             SUMMARY
        ================================================== -->

        <aside class="cart-summary">

          <p class="cart-summary__kicker">
            Récapitulatif
          </p>

          <h2 class="cart-summary__title">
            Votre commande
          </h2>


          <div class="cart-summary__details">

            <div class="cart-summary__row">

              <span>
                Sous-total HT
              </span>

              <strong>
                <%= number_to_currency(
                  subtotal_ht,
                  unit: "€",
                  format: "%n %u"
                ) %>
              </strong>

            </div>


            <div class="cart-summary__row">

              <span>
                TVA 20 %
              </span>

              <strong>
                <%= number_to_currency(
                  tva_total,
                  unit: "€",
                  format: "%n %u"
                ) %>
              </strong>

            </div>


            <div class="cart-summary__row cart-summary__row--delivery">

              <span>
                Livraison
              </span>

              <strong>
                Calculée à l’étape suivante
              </strong>

            </div>

          </div>


          <div class="cart-summary__total">

            <span>
              Total TTC
            </span>

            <strong>
              <%= number_to_currency(
                total_ttc,
                unit: "€",
                format: "%n %u"
              ) %>
            </strong>

          </div>


          <p class="cart-summary__tax-note">
            TVA 20 % incluse dans le montant total.
          </p>


          <div class="cart-summary__actions">

            <%= link_to(
              "Passer la commande",
              new_order_path,
              class: "cart-btn cart-btn--primary"
            ) %>

            <%= link_to(
              "Continuer la collection",
              products_path,
              class: "cart-btn cart-btn--outline"
            ) %>

          </div>


          <div class="cart-summary__reassurance">

            <div>
              <span>01</span>

              <p>
                Paiement sécurisé
              </p>
            </div>

            <div>
              <span>02</span>

              <p>
                Commande suivie depuis votre espace
              </p>
            </div>

          </div>

        </aside>

      </div>


    <% else %>

      <!-- =====================================================
           EMPTY CART
      ====================================================== -->

      <div class="cart-empty">

        <p class="cart-empty__kicker">
          Votre sélection
        </p>

        <h2 class="cart-empty__title">
          Votre panier est vide
        </h2>

        <p class="cart-empty__text">
          Découvrez la collection Maison Lumière
          et sélectionnez les pièces qui révéleront votre intérieur.
        </p>

        <%= link_to(
          "Explorer la collection",
          products_path,
          class: "cart-btn cart-btn--primary"
        ) %>

      </div>

    <% end %>

  </div>

</section>
