<div class="registration-page">

  <!-- =====================================================
       HERO
  ====================================================== -->

  <section
    class="registration-hero"
    aria-label="Univers Maison Lumière"
  >

    <div
      class="registration-hero__image"
      aria-hidden="true"
    ></div>

    <div
      class="registration-hero__overlay"
      aria-hidden="true"
    ></div>

    <div class="registration-hero__content">

      <p class="registration-hero__kicker">
        Maison Lumière
      </p>

      <h2 class="registration-hero__title">
        Votre espace,<br>
        votre lumière.
      </h2>

      <p class="registration-hero__text">
        Créez votre espace personnel pour retrouver
        vos commandes, votre panier et vos sélections.
      </p>

    </div>

  </section>


  <!-- =====================================================
       PANEL
  ====================================================== -->

  <section class="registration-panel">

    <div class="registration-card">

      <!-- =================================================
           HEADER
      ================================================== -->

      <header class="registration-header">

        <p class="registration-kicker">
          Espace particulier
        </p>

        <h1 class="registration-title">
          Créer un compte
        </h1>

        <p class="registration-subtitle">
          Créez votre compte pour accéder à votre panier,
          suivre vos commandes et profiter de Maison Lumière.
        </p>

      </header>


      <!-- =================================================
           FORMULAIRE
      ================================================== -->

      <%= form_for(
        resource,
        as: resource_name,
        url: registration_path(resource_name),
        html: { class: "registration-form" }
      ) do |f| %>

        <%= render "devise/shared/error_messages",
            resource: resource %>

        <%= f.hidden_field :account_type,
            value: "b2c" %>


        <div class="registration-field registration-field--half">

          <%= f.label :first_name,
              "Prénom",
              class: "registration-label" %>

          <%= f.text_field :first_name,
              autocomplete: "given-name",
              class: "registration-input" %>

        </div>


        <div class="registration-field registration-field--half">

          <%= f.label :last_name,
              "Nom",
              class: "registration-label" %>

          <%= f.text_field :last_name,
              autocomplete: "family-name",
              class: "registration-input" %>

        </div>


        <div class="registration-field">

          <%= f.label :email,
              "Adresse e-mail",
              class: "registration-label" %>

          <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              class: "registration-input" %>

        </div>


        <div class="registration-field">

          <%= f.label :phone,
              "Téléphone",
              class: "registration-label" %>

          <%= f.telephone_field :phone,
              autocomplete: "tel",
              class: "registration-input" %>

        </div>


        <div class="registration-field">

          <%= f.label :password,
              "Mot de passe",
              class: "registration-label" %>

          <% if @minimum_password_length %>

            <p class="registration-help">
              Minimum <%= @minimum_password_length %> caractères
            </p>

          <% end %>

          <%= f.password_field :password,
              autocomplete: "new-password",
              class: "registration-input" %>

        </div>


        <div class="registration-field">

          <%= f.label :password_confirmation,
              "Confirmation du mot de passe",
              class: "registration-label" %>

          <%= f.password_field :password_confirmation,
              autocomplete: "new-password",
              class: "registration-input" %>

        </div>


        <div class="registration-actions">

          <%= f.submit "Créer mon compte",
              class: "registration-submit" %>

        </div>

      <% end %>


      <div class="registration-links">

        <%= render "devise/shared/links" %>

      </div>


      <!-- =================================================
           PRO
      ================================================== -->

      <section class="registration-business">

        <p class="registration-business__kicker">
          Vous êtes professionnel ?
        </p>

        <h2 class="registration-business__title">
          Espace professionnel
        </h2>

        <p class="registration-business__text">
          Créez un compte dédié à votre activité
          et renseignez les informations de votre entreprise.
        </p>

        <%= link_to(
          "Créer un compte professionnel",
          new_business_registration_path,
          class: "registration-business__link"
        ) %>

      </section>

    </div>

  </section>

</div>
