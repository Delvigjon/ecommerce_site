<div class="login-page">

  <!-- =====================================================
       HERO VISUEL
  ====================================================== -->

  <section
    class="login-hero"
    aria-label="Univers Maison Lumière"
  >

    <div class="login-hero__image" aria-hidden="true"></div>

    <div class="login-hero__overlay" aria-hidden="true"></div>

    <div class="login-hero__content">

      <p class="login-hero__kicker">
        Maison Lumière
      </p>

      <h2 class="login-hero__title">
        La lumière<br>
        révèle l’espace.
      </h2>

      <p class="login-hero__text">
        Retrouvez vos commandes, votre panier
        et votre espace personnel.
      </p>

    </div>

  </section>


  <!-- =====================================================
       CONNEXION
  ====================================================== -->

  <section class="login-panel">

    <div class="login-card">

      <!-- =================================================
           HEADER
      ================================================== -->

      <header class="login-header">

        <p class="login-kicker">
          Espace membre
        </p>

        <h1 class="login-title">
          Connexion
        </h1>

        <p class="login-subtitle">
          Accédez à votre compte pour consulter votre panier
          et suivre vos commandes.
        </p>

      </header>


      <!-- =================================================
           FORMULAIRE
      ================================================== -->

      <%= form_for(
        resource,
        as: resource_name,
        url: session_path(resource_name),
        html: { class: "login-form" }
      ) do |f| %>


        <!-- EMAIL -->

        <div class="login-field">

          <%= f.label :email,
              "Adresse e-mail",
              class: "login-label" %>

          <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              class: "login-input",
              placeholder: "votre@email.fr" %>

        </div>


        <!-- PASSWORD -->

        <div class="login-field">

          <%= f.label :password,
              "Mot de passe",
              class: "login-label" %>

          <%= f.password_field :password,
              autocomplete: "current-password",
              class: "login-input",
              placeholder: "Votre mot de passe" %>

        </div>


        <!-- REMEMBER -->

        <% if devise_mapping.rememberable? %>

          <div class="login-options">

            <label class="login-remember">

              <%= f.check_box :remember_me,
                  class: "login-remember__input" %>

              <span class="login-remember__text">
                Se souvenir de moi
              </span>

            </label>

          </div>

        <% end %>


        <!-- SUBMIT -->

        <div class="login-actions">

          <%= f.submit "Se connecter",
              class: "login-submit" %>

        </div>

      <% end %>


      <!-- =================================================
           LIENS DEVISE
      ================================================== -->

      <div class="login-links">

        <%= render "devise/shared/links" %>

      </div>

    </div>

  </section>

</div>
