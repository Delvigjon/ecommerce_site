<div class="forge-home">

  <section class="forge-home__hero" aria-label="Accueil boutique luminaires">
    <div class="forge-home__hero-image" aria-hidden="true"></div>
    <div class="forge-home__hero-shade" aria-hidden="true"></div>

    <div class="forge-home__hero-inner">
      <div class="forge-home__hero-content">
        <p class="forge-home__eyebrow">Luminaires & éclairage intérieur</p>

        <h1 class="forge-home__title">
          Illuminez vos espaces<br>
          avec style
        </h1>

        <p class="forge-home__intro">
          Découvrez une sélection de luminaires modernes, décoratifs et fonctionnels.
          Suspensions, appliques, lampes et éclairages LED pour chaque pièce de la maison.
        </p>

        <div class="forge-home__hero-actions">
          <%= link_to "Découvrir la boutique", products_path, class: "forge-home__hero-link" %>
          <%= link_to "Nos offres lumineuses", offers_path, class: "forge-home__ghost-link" %>
        </div>

        <div class="forge-home__hero-proof">
          <span class="forge-home__proof-faces">● ● ●</span>
          <span>+2300 clients satisfaits</span>
          <span class="forge-home__stars">★★★★★</span>
          <span>4,9/5</span>
        </div>
      </div>
    </div>
  </section>

  <section class="forge-home__values" aria-label="Engagements de la boutique">
    <article class="forge-home__value">
      <span class="forge-home__value-icon">✦</span>
      <div>
        <h2>Design soigné</h2>
        <p>Des luminaires sélectionnés pour leur style et leur qualité.</p>
      </div>
    </article>

    <article class="forge-home__value">
      <span class="forge-home__value-icon">☼</span>
      <div>
        <h2>Éclairage efficace</h2>
        <p>Des solutions lumineuses adaptées à chaque usage.</p>
      </div>
    </article>

    <article class="forge-home__value">
      <span class="forge-home__value-icon">⌂</span>
      <div>
        <h2>Intérieur & extérieur</h2>
        <p>Des produits pour la maison, le jardin, les terrasses et les façades.</p>
      </div>
    </article>

    <article class="forge-home__value">
      <span class="forge-home__value-icon">✓</span>
      <div>
        <h2>Conseil personnalisé</h2>
        <p>Un accompagnement pour choisir le bon éclairage selon votre besoin.</p>
      </div>
    </article>
  </section>

  <section class="forge-home__collections" aria-labelledby="forge-home-collections-title">
    <div class="forge-home__section-heading">
      <h2 id="forge-home-collections-title">Nos univers lumineux</h2>
      <p>Une sélection pensée pour créer une ambiance chaleureuse, moderne et adaptée à chaque espace.</p>
    </div>

    <div class="forge-home__collection-grid">
      <%= link_to products_path, class: "forge-home__collection-card forge-home__collection-card--one" do %>
        <span>Suspensions</span>
        <small>Design, élégance & caractère</small>
        <strong>Découvrir</strong>
      <% end %>

      <%= link_to products_path, class: "forge-home__collection-card forge-home__collection-card--two" do %>
        <span>Appliques murales</span>
        <small>Ambiance douce & fonctionnelle</small>
        <strong>Découvrir</strong>
      <% end %>

      <%= link_to products_path, class: "forge-home__collection-card forge-home__collection-card--three" do %>
        <span>Éclairage LED</span>
        <small>Performance & économie d’énergie</small>
        <strong>Découvrir</strong>
      <% end %>

      <%= link_to offers_path, class: "forge-home__collection-card forge-home__collection-card--four" do %>
        <span>Offres lumineuses</span>
        <small>Sélections & packs avantageux</small>
        <strong>Découvrir</strong>
      <% end %>
    </div>
  </section>

  <section class="forge-home__products" aria-labelledby="forge-home-products-title">
    <div class="forge-home__products-head">
      <div>
        <p class="forge-home__section-kicker">Sélection boutique</p>
        <h2 id="forge-home-products-title">Nos meilleures ventes</h2>
      </div>

      <%= link_to "Voir toute la boutique", products_path, class: "forge-home__text-link" %>
    </div>

    <div class="forge-home__product-grid">
      <% @products.limit(5).each_with_index do |product, index| %>
        <article class="forge-home__product-card">
          <%= link_to product_path(product), class: "forge-home__product-media" do %>
            <% if index.zero? %>
              <span class="forge-home__product-badge">Best seller</span>
            <% elsif index == 2 %>
              <span class="forge-home__product-badge">Nouveau</span>
            <% end %>

            <span class="forge-home__product-favorite">♡</span>

            <% if product.image_url.present? %>
              <% src = product.image_url.to_s %>
              <%= image_tag(
                src.start_with?("http://", "https://") ? src : "products/#{src}",
                alt: product.name,
                class: "forge-home__product-image",
                loading: "lazy",
                decoding: "async"
              ) %>
            <% else %>
              <div class="forge-home__product-placeholder" aria-hidden="true"></div>
            <% end %>
          <% end %>

          <div class="forge-home__product-body">
            <h3><%= product.name %></h3>

            <% if product.respond_to?(:description) && product.description.present? %>
              <p><%= truncate(strip_tags(product.description), length: 52) %></p>
            <% else %>
              <p>Luminaire moderne pour sublimer votre intérieur.</p>
            <% end %>

            <div class="forge-home__product-rating">
              <span>★★★★★</span>
              <small>(<%= 48 + index * 17 %>)</small>
            </div>

            <div class="forge-home__product-bottom">
              <strong>
                <%= number_to_currency(product.price, unit: "€", format: "%n %u") %>
              </strong>

              <%= link_to "Voir", product_path(product), class: "forge-home__product-link" %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  </section>

  <section class="forge-home__feature" aria-label="Offres lumineuses et packs éclairage">
    <div class="forge-home__feature-media">
      <div class="forge-home__feature-image" aria-hidden="true"></div>
    </div>

    <div class="forge-home__feature-content">
      <p class="forge-home__section-kicker">Offres & sélections lumineuses</p>

      <h2>Des luminaires pensés pour chaque ambiance</h2>

      <p>
        Créez une atmosphère chaleureuse, moderne ou fonctionnelle grâce à nos
        suspensions, appliques, lampes et solutions LED sélectionnées avec soin.
      </p>

      <%= link_to "Découvrir les offres", offers_path, class: "forge-home__hero-link" %>
    </div>

    <div class="forge-home__feature-list">
      <div>
        <strong>Packs éclairage</strong>
        <span>Solutions complètes</span>
      </div>

      <div>
        <strong>LED économique</strong>
        <span>Consommation maîtrisée</span>
      </div>

      <div>
        <strong>Ambiance déco</strong>
        <span>Style et confort visuel</span>
      </div>
    </div>
  </section>

  <section class="forge-home__service-strip" aria-label="Services">
    <article>
      <strong>Paiement sécurisé</strong>
      <span>CB, PayPal, 3x sans frais</span>
    </article>

    <article>
      <strong>Satisfait ou remboursé</strong>
      <span>14 jours pour changer d’avis</span>
    </article>

    <article>
      <strong>Expédition rapide</strong>
      <span>En 24/48h ouvrées</span>
    </article>

    <article>
      <strong>Service client</strong>
      <span>Réponse sous 24h</span>
    </article>
  </section>

</div>
