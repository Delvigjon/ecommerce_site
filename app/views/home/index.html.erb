<div class="home">

  <!-- =====================================================
       HERO — MANIFESTE
  ====================================================== -->

  <section class="home__hero" aria-labelledby="home-hero-title">

    <div class="home__hero-image" aria-hidden="true"></div>
    <div class="home__hero-overlay" aria-hidden="true"></div>

    <div class="home__hero-inner">

      <div class="home__hero-content">

        <p class="home__hero-kicker">
          Intemporelle. Essentielle. Vivante.
        </p>

        <h1
          id="home-hero-title"
          class="home__hero-title"
        >
          La lumière<br>
          sculpte l’espace
        </h1>

        <p class="home__hero-intro">
          Des luminaires d’exception où le design rencontre
          la matière, l’architecture et l’émotion.
        </p>

        <%= link_to(
          products_path,
          class: "home__editorial-link"
        ) do %>

          <span>
            Découvrir la collection
          </span>

          <span
            class="home__editorial-arrow"
            aria-hidden="true"
          >
            →
          </span>

        <% end %>

      </div>

    </div>


    <!-- ===================================================
         UNIVERS INTÉGRÉS AU HERO
    ==================================================== -->

    <div class="home__hero-categories">

      <%= link_to(
        products_path,
        class: "home__hero-category home__hero-category--suspensions"
      ) do %>

        <div class="home__hero-category-copy">

          <span class="home__hero-category-number">
            01
          </span>

          <h2>
            Suspensions
          </h2>

          <span class="home__hero-category-link">
            Découvrir
          </span>

        </div>

      <% end %>


      <%= link_to(
        products_path,
        class: "home__hero-category home__hero-category--table"
      ) do %>

        <div class="home__hero-category-copy">

          <span class="home__hero-category-number">
            02
          </span>

          <h2>
            Lampes à poser
          </h2>

          <span class="home__hero-category-link">
            Découvrir
          </span>

        </div>

      <% end %>


      <%= link_to(
        products_path,
        class: "home__hero-category home__hero-category--wall"
      ) do %>

        <div class="home__hero-category-copy">

          <span class="home__hero-category-number">
            03
          </span>

          <h2>
            Appliques
          </h2>

          <span class="home__hero-category-link">
            Découvrir
          </span>

        </div>

      <% end %>


      <%= link_to(
        products_path,
        class: "home__hero-category home__hero-category--floor"
      ) do %>

        <div class="home__hero-category-copy">

          <span class="home__hero-category-number">
            04
          </span>

          <h2>
            Lampadaires
          </h2>

          <span class="home__hero-category-link">
            Découvrir
          </span>

        </div>

      <% end %>

    </div>

  </section>


  <!-- =====================================================
       MANIFESTE CLAIR
  ====================================================== -->

  <section class="home__manifesto">

    <div class="home__manifesto-inner">

      <div class="home__manifesto-heading">

        <span class="home__section-number">
          01
        </span>

        <h2>
          L’art de<br>
          la lumière
        </h2>

      </div>


      <div class="home__manifesto-copy">

        <p class="home__manifesto-lead">
          Chaque création Maison Lumière est pensée
          comme une sculpture de lumière.
        </p>

        <p>
          Des matériaux nobles, des lignes pures et une exigence
          absolue du détail pour révéler les volumes et transformer
          la perception d’un intérieur.
        </p>

        <%= link_to(
          about_path,
          class: "home__light-link"
        ) do %>

          <span>
            Découvrir notre philosophie
          </span>

          <span aria-hidden="true">
            →
          </span>

        <% end %>

      </div>

    </div>

  </section>


  <!-- =====================================================
       COLLECTION — ÉDITORIAL
  ====================================================== -->

  <section
    class="home__collection"
    aria-labelledby="home-collection-title"
  >

    <header class="home__section-header">

      <div>

        <span class="home__section-number">
          02 / Collection
        </span>

        <h2 id="home-collection-title">
          Des objets de lumière
        </h2>

      </div>

      <p>
        Une sélection guidée par la forme,
        la matière et la manière dont la lumière habite l’espace.
      </p>

    </header>


    <!-- SUSPENSIONS -->

    <article class="home__editorial home__editorial--left">

      <div class="home__editorial-media home__editorial-media--suspension">
      </div>

      <div class="home__editorial-copy">

        <span class="home__editorial-index">
          Collection 01
        </span>

        <h3>
          Suspensions
        </h3>

        <p>
          Des pièces aériennes qui structurent les volumes
          et donnent à la lumière une présence architecturale.
        </p>

        <%= link_to(
          "Explorer les suspensions →",
          products_path,
          class: "home__editorial-link"
        ) %>

      </div>

    </article>


    <!-- APPLIQUES -->

    <article class="home__editorial home__editorial--right">

      <div class="home__editorial-copy">

        <span class="home__editorial-index">
          Collection 02
        </span>

        <h3>
          Lumière murale
        </h3>

        <p>
          Des appliques graphiques et discrètes,
          pensées pour révéler les matières et souligner
          les lignes de l’architecture.
        </p>

        <%= link_to(
          "Explorer les appliques →",
          products_path,
          class: "home__editorial-link"
        ) %>

      </div>

      <div class="home__editorial-media home__editorial-media--wall">
      </div>

    </article>

  </section>


  <!-- =====================================================
       SÉLECTION PRODUITS
  ====================================================== -->

  <section
    class="home__products"
    aria-labelledby="home-products-title"
  >

    <header class="home__products-header">

      <div>

        <span class="home__section-number">
          03 / Sélection
        </span>

        <h2 id="home-products-title">
          Pièces choisies
        </h2>

      </div>

      <%= link_to(
        "Voir toute la collection →",
        products_path,
        class: "home__products-all"
      ) %>

    </header>


    <div class="home__product-grid">

      <% @products.limit(4).each_with_index do |product, index| %>

        <article class="home__product">

          <%= link_to(
            product_path(product),
            class: "home__product-media"
          ) do %>

            <% if product.image_url.present? %>

              <% src = product.image_url.to_s %>

              <%= image_tag(
                src.start_with?("http://", "https://") ? src : "products/#{src}",
                alt: product.name,
                class: "home__product-image",
                loading: "lazy",
                decoding: "async"
              ) %>

            <% else %>

              <div class="home__product-placeholder"></div>

            <% end %>


            <span class="home__product-index">
              <%= format("%02d", index + 1) %>
            </span>

          <% end %>


          <div class="home__product-info">

            <div>

              <h3>
                <%= product.name %>
              </h3>

              <% if product.description.present? %>

                <p>
                  <%= truncate(
                    strip_tags(product.description),
                    length: 58
                  ) %>
                </p>

              <% end %>

            </div>


            <div class="home__product-price">

              <%= number_to_currency(
                product.price,
                unit: "€",
                format: "%n %u"
              ) %>

            </div>

          </div>

        </article>

      <% end %>

    </div>

  </section>


  <!-- =====================================================
       GRANDE IMMERSION
  ====================================================== -->

  <section class="home__experience">

    <div class="home__experience-image"></div>
    <div class="home__experience-overlay"></div>

    <div class="home__experience-content">

      <span class="home__section-number">
        04 / Atmosphère
      </span>

      <h2>
        La lumière ne décore pas.<br>
        Elle transforme.
      </h2>

      <p>
        Température, intensité, matière, orientation :
        chaque détail participe à la perception d’un espace.
      </p>

      <%= link_to(
        about_path,
        class: "home__editorial-link"
      ) do %>

        <span>
          Découvrir Maison Lumière
        </span>

        <span aria-hidden="true">
          →
        </span>

      <% end %>

    </div>

  </section>


  <!-- =====================================================
       SERVICES — DISCRETS
  ====================================================== -->

  <section
    class="home__services"
    aria-label="Services Maison Lumière"
  >

    <article>

      <span>
        01
      </span>

      <strong>
        Livraison soignée
      </strong>

      <p>
        Préparation et expédition pensées
        pour protéger chaque pièce.
      </p>

    </article>


    <article>

      <span>
        02
      </span>

      <strong>
        Paiement sécurisé
      </strong>

      <p>
        Transactions protégées et solutions
        de paiement adaptées.
      </p>

    </article>


    <article>

      <span>
        03
      </span>

      <strong>
        Conseil lumière
      </strong>

      <p>
        Un accompagnement pour choisir
        l’éclairage adapté à votre espace.
      </p>

    </article>

  </section>

</div>
