<%# app/views/shared/_header.html.erb %>

<nav
  class="nav"
  role="navigation"
  aria-label="Navigation principale"
>

  <div class="nav__inner">


    <!-- =====================================================
         NAV LEFT
    ====================================================== -->

    <ul class="nav__links nav__links--left">

      <li class="nav__item">
        <%= link_to(
          "Collections",
          products_path,
          class: "nav__link"
        ) %>
      </li>

      <li class="nav__item">
        <%= link_to(
          "La Maison",
          about_path,
          class: "nav__link"
        ) %>
      </li>

      <li class="nav__item">
        <%= link_to(
          "Journal",
          root_path,
          class: "nav__link"
        ) %>
      </li>

      <li class="nav__item">
        <%= link_to(
          "Sur-mesure",
          contact_path,
          class: "nav__link"
        ) %>
      </li>

    </ul>


    <!-- =====================================================
         BRAND
    ====================================================== -->

    <%= link_to(
      root_path,
      class: "nav__brand",
      aria: {
        label: "Retour à l'accueil"
      }
    ) do %>

      <span class="nav__brand-sub">
        Maison
      </span>

      <span class="nav__brand-main">
        Lumière
      </span>

    <% end %>


    <!-- =====================================================
         ACTIONS
    ====================================================== -->

    <div class="nav__actions">

      <% if user_signed_in? %>


        <!-- =================================================
             BACK-OFFICE
             ADMIN UNIQUEMENT
        ================================================== -->

        <% if current_user.role == "admin" %>

          <%= link_to(
            backoffice_root_path,
            class: "nav__utility-link nav__utility-link--admin",
            aria: {
              label: "Accéder au back-office"
            }
          ) do %>

            <span>
              Back-office
            </span>

            <i
              class="fa-solid fa-gauge-high"
              aria-hidden="true"
            ></i>

          <% end %>

        <% end %>


        <!-- =================================================
             COMMANDES
        ================================================== -->

        <%= link_to(
          orders_path,
          class: "nav__utility-link",
          aria: {
            label: "Mes commandes"
          }
        ) do %>

          <span>
            Commandes
          </span>

        <% end %>


        <!-- =================================================
             COMPTE
        ================================================== -->

        <%= link_to(
          edit_user_registration_path,
          class: "nav__utility-link",
          aria: {
            label: "Mon compte"
          }
        ) do %>

          <span>
            Compte
          </span>

          <i
            class="fa-regular fa-user"
            aria-hidden="true"
          ></i>

        <% end %>


        <!-- =================================================
             PANIER
        ================================================== -->

        <% if current_user.cart.present? %>

          <%
            qty =
              current_user
                .cart
                .cart_items
                .sum(:quantity)
                .to_i
          %>

          <%= link_to(
            cart_path(current_user.cart),
            class: "nav__utility-link nav__cart",
            aria: {
              label: "Panier"
            }
          ) do %>

            <span>
              Panier
            </span>

            <% if qty > 0 %>

              <span class="nav__cart-count">
                (<%= qty %>)
              </span>

            <% end %>

          <% end %>

        <% end %>


        <!-- =================================================
             DÉCONNEXION
        ================================================== -->

        <%= button_to(
          destroy_user_session_path,
          method: :delete,
          class: "nav__logout",
          form_class: "nav__logout-form",
          data: {
            controller: "confirm-modal",
            action: "click->confirm-modal#open",
            confirm_modal_title_value: "Déconnexion",
            confirm_modal_message_value: "Voulez-vous vraiment vous déconnecter de votre espace Maison Lumière ?",
            confirm_modal_confirm_value: "Se déconnecter"
          },
          aria: {
            label: "Déconnexion"
          }
        ) do %>

          <i
            class="fa-solid fa-arrow-right-from-bracket"
            aria-hidden="true"
          ></i>

        <% end %>


      <% else %>


        <!-- =================================================
             CONNEXION
        ================================================== -->

        <%= link_to(
          new_user_session_path,
          class: "nav__utility-link"
        ) do %>

          <span>
            Connexion
          </span>

        <% end %>


        <!-- =================================================
             CRÉATION DE COMPTE
        ================================================== -->

        <%= link_to(
          new_user_registration_path,
          class: "nav__utility-link nav__utility-link--account"
        ) do %>

          <span>
            Compte
          </span>

          <i
            class="fa-regular fa-user"
            aria-hidden="true"
          ></i>

        <% end %>

      <% end %>

    </div>

  </div>

</nav>
