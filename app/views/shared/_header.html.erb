<nav class="forge-nav" role="navigation" aria-label="Navigation principale">
  <div class="forge-nav__inner">

    <%= link_to root_path, class: "forge-nav__brand", aria: { label: "Retour à l'accueil" } do %>
      <span class="forge-nav__brand-main">La Forge</span>
      <span class="forge-nav__brand-sub">Éternelle</span>
    <% end %>

    <ul class="forge-nav__links">
      <li><%= link_to "Accueil", root_path, class: "forge-nav__link" %></li>
      <li><%= link_to "À propos", about_path, class: "forge-nav__link" %></li>
      <li><%= link_to "Boutique", products_path, class: "forge-nav__link" %></li>
      <li><%= link_to "Pièces uniques", offers_path, class: "forge-nav__link" %></li>
      <li><%= link_to "Contact", contact_path, class: "forge-nav__link" %></li>
    </ul>

    <div class="forge-nav__actions">
      <% if user_signed_in? %>

        <%= link_to orders_path, class: "forge-nav__action", aria: { label: "Mes commandes" } do %>
          <i class="fas fa-box" aria-hidden="true"></i>
          <span>Commandes</span>
        <% end %>

        <%= link_to edit_user_registration_path, class: "forge-nav__action", aria: { label: "Mon compte" } do %>
          <i class="fas fa-user" aria-hidden="true"></i>
          <span>Compte</span>
        <% end %>

        <% if current_user.cart.present? %>
          <%= link_to cart_path(current_user.cart), class: "forge-nav__action forge-nav__cart", aria: { label: "Panier" } do %>
            <i class="fas fa-shopping-bag" aria-hidden="true"></i>

            <% qty = current_user.cart&.cart_items&.sum(:quantity).to_i %>
            <% if qty > 0 %>
              <span class="forge-nav__badge"><%= qty %></span>
            <% end %>
          <% end %>
        <% end %>

        <%= button_to destroy_user_session_path,
            method: :delete,
            class: "forge-nav__logout",
            form_class: "forge-nav__logout-form",
            data: { turbo_confirm: "Se déconnecter ?" },
            aria: { label: "Déconnexion" } do %>
          <i class="fas fa-right-from-bracket" aria-hidden="true"></i>
        <% end %>

      <% else %>

        <%= link_to new_user_session_path, class: "forge-nav__action forge-nav__login" do %>
          <i class="fas fa-user" aria-hidden="true"></i>
          <span>Connexion</span>
        <% end %>

        <%= link_to new_user_registration_path, class: "forge-nav__customer-link" do %>
          Créer un compte
        <% end %>

      <% end %>
    </div>

  </div>
</nav>
