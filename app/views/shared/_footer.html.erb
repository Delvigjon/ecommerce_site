<footer class="forge-footer" role="contentinfo">
  <div class="forge-footer__inner">

    <div class="forge-footer__grid">

      <div class="forge-footer__brand">
        <%= link_to root_path, class: "forge-footer__logo", aria: { label: "Retour à l'accueil" } do %>
          <span class="forge-footer__logo-main">La Forge</span>
          <span class="forge-footer__logo-sub">Éternelle</span>
        <% end %>

        <p class="forge-footer__text">
          Coutellerie artisanale spécialisée dans les couteaux forgés à la main,
          les pièces uniques et les créations de caractère façonnées avec soin
          dans un esprit brut, durable et authentique.
        </p>

        <ul class="forge-footer__infos">
          <li>Couteaux forgés à la main</li>
          <li>Pièces uniques & petites séries</li>
          <li>Savoir-faire artisanal français</li>
        </ul>
      </div>

      <div class="forge-footer__col">
        <h3 class="forge-footer__heading">Navigation</h3>

        <nav class="forge-footer__nav" aria-label="Navigation footer">
          <%= link_to "Accueil", root_path %>
          <%= link_to "Boutique", products_path %>
          <%= link_to "Pièces uniques", offers_path %>
          <%= link_to "À propos", about_path %>
          <%= link_to "Contact", contact_path %>
        </nav>
      </div>

      <div class="forge-footer__col">
        <h3 class="forge-footer__heading">La boutique</h3>

        <div class="forge-footer__nav">
          <%= link_to "Catalogue complet", products_path %>
          <%= link_to "Dernières créations", products_path %>
          <%= link_to "Sélections de l’atelier", offers_path %>
          <%= link_to "Mon compte", new_user_session_path %>
          <%= link_to "Mon panier",
              (user_signed_in? && current_user.cart.present? ? cart_path(current_user.cart) : new_user_session_path) %>
        </div>
      </div>

      <div class="forge-footer__col">
        <h3 class="forge-footer__heading">L’atelier</h3>

        <p class="forge-footer__text">
          Chaque lame raconte une histoire : celle du feu, de l’acier,
          du geste et du temps passé à créer une pièce singulière.
        </p>

        <div class="forge-footer__badges">
          <span class="forge-footer__badge">Fait main</span>
          <span class="forge-footer__badge">Acier sélectionné</span>
          <span class="forge-footer__badge">Fabrication française</span>
        </div>
      </div>

    </div>

    <div class="forge-footer__bottom">
      <div class="forge-footer__bottom-left">
        <p class="forge-footer__copyright">
          © <%= Time.current.year %> La Forge Éternelle — Tous droits réservés
        </p>

        <p class="forge-footer__bottom-note">
          Coutellerie artisanale & pièces forgées à la main
        </p>
      </div>

      <div class="forge-footer__credits">
        <span class="forge-footer__credits-label">Site propulsé par</span>

        <%= link_to "https://www.titouweb.com",
            target: "_blank",
            rel: "noopener",
            class: "forge-footer__developer" do %>

          <%= image_tag "logo titouweb.png",
              alt: "TitouWeb",
              class: "forge-footer__developer-logo" %>

          <span class="forge-footer__developer-name">TitouWeb</span>
        <% end %>
      </div>
    </div>

  </div>
</footer>
