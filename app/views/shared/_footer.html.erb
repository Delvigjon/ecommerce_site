<footer class="footer" role="contentinfo">

  <div class="footer__inner">

    <!-- =====================================================
         INTRO / SIGNATURE
    ====================================================== -->

    <div class="footer__top">

      <div class="footer__brand">

        <%= link_to(
          root_path,
          class: "footer__logo",
          aria: { label: "Maison Lumière — Accueil" }
        ) do %>

          <span class="footer__logo-sub">
            Maison
          </span>

          <span class="footer__logo-main">
            Lumière
          </span>

        <% end %>

      </div>


      <div class="footer__statement">

        <p class="footer__statement-kicker">
          La lumière comme matière
        </p>

        <p class="footer__statement-text">
          Des luminaires choisis pour leur présence,
          leurs lignes et la lumière qu’ils dessinent
          dans l’espace.
        </p>

      </div>

    </div>


    <!-- =====================================================
         CONTENU
    ====================================================== -->

    <div class="footer__content">

      <!-- COLLECTIONS -->

      <div class="footer__col">

        <p class="footer__heading">
          Collections
        </p>

        <nav
          class="footer__nav"
          aria-label="Collections"
        >

          <%= link_to "Suspensions", products_path %>

          <%= link_to "Appliques", products_path %>

          <%= link_to "Lampes", products_path %>

          <%= link_to "Éclairage LED", products_path %>

          <%= link_to "Toutes les pièces", products_path %>

        </nav>

      </div>


      <!-- MAISON -->

      <div class="footer__col">

        <p class="footer__heading">
          La Maison
        </p>

        <nav
          class="footer__nav"
          aria-label="La Maison"
        >

          <%= link_to "Notre histoire", about_path %>

          <%= link_to "Nos sélections", offers_path %>

          <%= link_to "Conseils lumière", about_path %>

          <%= link_to "Contact", contact_path %>

        </nav>

      </div>


      <!-- SERVICES -->

      <div class="footer__col">

        <p class="footer__heading">
          Services
        </p>

        <nav
          class="footer__nav"
          aria-label="Services"
        >

          <% if user_signed_in? %>

            <%= link_to "Mon compte",
                edit_user_registration_path %>

            <%= link_to "Mes commandes",
                orders_path %>

            <% if current_user.cart.present? %>

              <%= link_to "Mon panier",
                  cart_path(current_user.cart) %>

            <% end %>

          <% else %>

            <%= link_to "Mon compte",
                new_user_session_path %>

          <% end %>

          <%= link_to "Livraison & retours", contact_path %>

          <%= link_to "Nous contacter", contact_path %>

        </nav>

      </div>


      <!-- CONTACT / NEWSLETTER -->

      <div class="footer__col footer__col--contact">

        <p class="footer__heading">
          Maison Lumière
        </p>

        <p class="footer__contact-text">
          Une question sur une pièce, une ambiance
          ou le choix d’un luminaire ?
        </p>

        <%= link_to(
          contact_path,
          class: "footer__contact-link"
        ) do %>

          <span>
            Échanger avec la Maison
          </span>

          <span
            class="footer__contact-arrow"
            aria-hidden="true"
          >
            →
          </span>

        <% end %>

      </div>

    </div>


    <!-- =====================================================
         SIGNATURE
    ====================================================== -->

    <div class="footer__signature">

      <p>
        Éclairer un espace,
        <em>c’est aussi le dessiner.</em>
      </p>

    </div>


    <!-- =====================================================
         BOTTOM
    ====================================================== -->

    <div class="footer__bottom">

      <div class="footer__legal">

        <span>
          © <%= Time.current.year %> Maison Lumière
        </span>

        <span class="footer__legal-separator">
          ·
        </span>

        <%= link_to "Mentions légales", "#" %>

        <span class="footer__legal-separator">
          ·
        </span>

        <%= link_to "Confidentialité", "#" %>

        <span class="footer__legal-separator">
          ·
        </span>

        <%= link_to "CGV", "#" %>

      </div>


      <!-- TITOUWEB -->

      <div class="footer__credits">

        <span class="footer__credits-label">
          Conception & développement
        </span>

        <%= link_to(
          "https://www.titouweb.com",
          target: "_blank",
          rel: "noopener",
          class: "footer__developer"
        ) do %>

          <%= image_tag(
            "logo titouweb.png",
            alt: "",
            class: "footer__developer-logo"
          ) %>

          <span>
            TitouWeb
          </span>

        <% end %>

      </div>

    </div>

  </div>

</footer>
