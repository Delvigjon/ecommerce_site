<div class="products-index" data-controller="catalog-filter">

  <!-- =====================================================
       HERO
  ====================================================== -->

  <section class="products-index__hero">

    <div
      class="products-index__hero-image"
      aria-hidden="true"
    ></div>

    <div
      class="products-index__hero-overlay"
      aria-hidden="true"
    ></div>

    <div class="products-index__hero-inner">

      <p class="products-index__kicker">
        Collection Maison Lumière
      </p>

      <h1 class="products-index__title">
        Nos pièces<br>
        de lumière
      </h1>

      <p class="products-index__text">
        Une sélection de luminaires choisis pour leur présence,
        leur matière et la manière dont ils transforment l’espace.
      </p>


      <!-- =================================================
           FILTERS
      ================================================== -->

      <div class="products-index__filters">

        <button
          type="button"
          class="products-index__filter is-active"
          data-action="click->catalog-filter#filter"
          data-category="all"
        >
          Tous
        </button>

        <button
          type="button"
          class="products-index__filter"
          data-action="click->catalog-filter#filter"
          data-category="suspension"
        >
          Suspensions
        </button>

        <button
          type="button"
          class="products-index__filter"
          data-action="click->catalog-filter#filter"
          data-category="applique"
        >
          Appliques
        </button>

        <button
          type="button"
          class="products-index__filter"
          data-action="click->catalog-filter#filter"
          data-category="led"
        >
          LED
        </button>

        <button
          type="button"
          class="products-index__filter"
          data-action="click->catalog-filter#filter"
          data-category="exterieur"
        >
          Extérieur
        </button>

      </div>

    </div>

  </section>


  <!-- =====================================================
       PRODUCTS
  ====================================================== -->

  <section class="products-index__products">

    <div class="products-index__grid">

      <% if @products.present? %>

        <% @products.each_with_index do |product, index| %>

          <% product_name = product.name.to_s.downcase %>

          <% product_category =
            if product_name.include?("suspension")
              "suspension"
            elsif product_name.include?("applique")
              "applique"
            elsif product_name.include?("led") ||
                  product_name.include?("ruban") ||
                  product_name.include?("spot") ||
                  product_name.include?("ampoule")
              "led"
            elsif product_name.include?("extérieur") ||
                  product_name.include?("exterieur") ||
                  product_name.include?("borne") ||
                  product_name.include?("projecteur") ||
                  product_name.include?("guirlande") ||
                  product_name.include?("hublot")
              "exterieur"
            else
              "other"
            end
          %>

          <article
            class="product-card"
            data-catalog-filter-target="product"
            data-category="<%= product_category %>"
          >

            <!-- =============================================
                 MEDIA
            ============================================== -->

            <%= link_to(
              product_path(product),
              class: "product-card__media"
            ) do %>

              <% if product.image_url.present? %>

                <%= image_tag(
                  product.image_url,
                  alt: product.name,
                  class: "product-card__image",
                  loading: "lazy",
                  decoding: "async"
                ) %>

              <% else %>

                <div
                  class="product-card__placeholder"
                  aria-hidden="true"
                ></div>

              <% end %>


              <span class="product-card__index">
                <%= format("%02d", index + 1) %>
              </span>


              <% if product.stock.to_i <= 0 %>

                <span class="product-card__availability product-card__availability--out">
                  Rupture
                </span>

              <% else %>

                <span class="product-card__availability">
                  Disponible
                </span>

              <% end %>

            <% end %>


            <!-- =============================================
                 CONTENT
            ============================================== -->

            <div class="product-card__body">

              <p class="product-card__category">
                Maison Lumière
              </p>

              <h2 class="product-card__title">

                <%= link_to(
                  product.name,
                  product_path(product)
                ) %>

              </h2>


              <% if product.description.present? %>

                <p class="product-card__text">

                  <%= truncate(
                    strip_tags(product.description),
                    length: 90
                  ) %>

                </p>

              <% end %>


              <div class="product-card__footer">

                <strong class="product-card__price">

                  <%= number_to_currency(
                    product.price,
                    unit: "€",
                    format: "%n %u"
                  ) %>

                </strong>

                <%= link_to(
                  product_path(product),
                  class: "product-card__link"
                ) do %>

                  <span>
                    Découvrir
                  </span>

                  <span aria-hidden="true">
                    →
                  </span>

                <% end %>

              </div>

            </div>

          </article>

        <% end %>


      <% else %>

        <div class="products-index__empty">

          <p class="products-index__empty-kicker">
            Collection
          </p>

          <h2>
            Aucun luminaire disponible
          </h2>

          <p>
            De nouvelles pièces rejoindront prochainement
            la collection Maison Lumière.
          </p>

        </div>

      <% end %>

    </div>

  </section>

</div>
