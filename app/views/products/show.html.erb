<section class="product-show-page">

  <div class="product-show-container">

    <!-- =====================================================
    BREADCRUMB
    ====================================================== -->

    <nav class="product-show-breadcrumb" aria-label="Fil d’Ariane">

      <%= link_to "Accueil", root_path %>

      <span aria-hidden="true">/</span>

      <%= link_to "Collection", products_path %>

      <span aria-hidden="true">/</span>

      <span>
        <%= @product.name %>
      </span>

    </nav>


    <!-- =====================================================
    PRODUCT
    ====================================================== -->

    <article class="product-show-card">

      <!-- =================================================
      MEDIA
      ================================================== -->

      <div class="product-show-media">

        <% if @product.image_url.present? %>

          <%= image_tag(
            @product.image_url,
            alt: @product.name,
            class: "product-show-image"
          ) %>

        <% else %>

          <div
            class="product-show-image product-show-image--placeholder"
            aria-hidden="true">
          </div>

        <% end %>


        <span class="product-show-index">
          Maison Lumière
        </span>


        <% if @product.stock.to_i <= 0 %>

          <span class="product-show-badge product-show-badge--out">
            Indisponible
          </span>

        <% end %>

      </div>


      <!-- =================================================
      CONTENT
      ================================================== -->

      <div class="product-show-content">

        <p class="product-show-kicker">
          Collection Maison Lumière
        </p>


        <h1 class="product-show-title">
          <%= @product.name %>
        </h1>


        <p class="product-show-price">
          <%= number_to_currency(
            @product.price,
            unit: "€",
            format: "%n %u"
          ) %>
        </p>


        <div class="product-show-status">

          <% if @product.stock.to_i > 0 %>

            <span class="product-show-status__dot"></span>

            <span>
              Disponible
            </span>

          <% else %>

            <span class="product-show-status__dot product-show-status__dot--out"></span>

            <span>
              Actuellement indisponible
            </span>

          <% end %>

        </div>


        <!-- ===============================================
        DESCRIPTION
        ================================================ -->

        <div class="product-show-description">

          <p class="product-show-description__kicker">
            01 / La pièce
          </p>

          <h2 class="product-show-section-title">
            Description
          </h2>

          <p>
            <% if @product.description.present? %>


              <%= @product.description %>


            <% else %>


              Une pièce lumineuse sélectionnée pour sa présence,
              son équilibre et sa capacité à transformer
              l’atmosphère d’un espace.


            <% end %>
          </p>

        </div>


        <!-- ===============================================
        ACTIONS
        ================================================ -->

        <div class="product-show-actions">

          <% if @product.stock.to_i > 0 %>

            <% if user_signed_in? && @cart.present? %>

              <%= button_to(
                "Ajouter au panier",
                cart_cart_items_path(@cart),
                params: {
                  product_id: @product.id,
                  quantity: 1
                },
                method: :post,
                class: "product-show-button product-show-button--primary"
              ) %>

            <% else %>

              <%= link_to(
                "Se connecter pour commander",
                new_user_session_path,
                class: "product-show-button product-show-button--primary"
              ) %>

            <% end %>

          <% else %>

            <button
              class="product-show-button product-show-button--disabled"
              disabled>
              Indisponible
            </button>

          <% end %>


          <%= link_to(
            "Retour à la collection",
            products_path,
            class: "product-show-button product-show-button--outline"
          ) %>

        </div>

      </div>

    </article>


    <!-- =====================================================
    RELATED
    ====================================================== -->

    <% if @related_products.present? %>

      <section
        class="product-related-section"
        aria-labelledby="related-products-title">

        <header class="product-related-header">

          <div>

            <p class="product-related-kicker">
              Collection
            </p>

            <h2
              id="related-products-title"
              class="product-related-title">
              À découvrir également
            </h2>

          </div>

          <p class="product-related-text">
            D’autres pièces sélectionnées pour prolonger
            l’atmosphère Maison Lumière.
          </p>

        </header>


        <div class="product-related-grid">

          <% @related_products.each_with_index do |related_product, index| %>

            <article class="product-related-card">

              <%= link_to(
                product_path(related_product),
                class: "product-related-card__media"
              ) do %>

                <% if related_product.image_url.present? %>

                  <%= image_tag(
                    related_product.image_url,
                    alt: related_product.name,
                    class: "product-related-card__image",
                    loading: "lazy"
                  ) %>

                <% else %>

                  <div
                    class="product-related-card__image product-related-card__image--placeholder"
                    aria-hidden="true">
                  </div>

                <% end %>


                <span class="product-related-card__index">
                  <%= format("%02d", index + 1) %>
                </span>

              <% end %>


              <div class="product-related-card__body">

                <p class="product-related-card__category">
                  Maison Lumière
                </p>

                <h3 class="product-related-card__title">

                  <%= link_to(
                    related_product.name,
                    product_path(related_product)
                  ) %>

                </h3>


                <div class="product-related-card__footer">

                  <strong class="product-related-card__price">

                    <%= number_to_currency(
                      related_product.price,
                      unit: "€",
                      format: "%n %u"
                    ) %>

                  </strong>


                  <%= link_to(
                    product_path(related_product),
                    class: "product-related-card__link"
                  ) do %>

                    Découvrir <span aria-hidden="true">→</span>

                  <% end %>

                </div>

              </div>

            </article>

          <% end %>

        </div>

      </section>

    <% end %>

  </div>

</section>
