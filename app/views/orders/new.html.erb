
<section class="checkout-page">

  <div class="checkout-container">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="checkout-header">

      <div class="checkout-header__main">

        <p class="checkout-kicker">
          Étape 02 — Validation
        </p>

        <h1 class="checkout-title">
          Finaliser<br>
          votre commande
        </h1>

      </div>

      <div class="checkout-header__aside">

        <p class="checkout-subtitle">
          Vérifiez une dernière fois votre sélection avant
          de poursuivre vers notre espace de paiement sécurisé.
        </p>

        <div class="checkout-steps" aria-label="Progression de la commande">

          <div class="checkout-step checkout-step--complete">
            <span>01</span>
            <p>Panier</p>
          </div>

          <div class="checkout-step checkout-step--active">
            <span>02</span>
            <p>Validation</p>
          </div>

          <div class="checkout-step">
            <span>03</span>
            <p>Paiement</p>
          </div>

        </div>

      </div>

    </header>


    <% if @cart&.cart_items.any? %>

      <%
        tva_rate = 0.20

        total_ttc = @cart.cart_items.sum do |item|
          item.product.price.to_f * item.quantity
        end

        subtotal_ht = total_ttc / (1 + tva_rate)
        tva_total   = total_ttc - subtotal_ht
      %>


      <!-- =====================================================
           LAYOUT
      ====================================================== -->

      <div class="checkout-layout">

        <!-- ===================================================
             ORDER
        ==================================================== -->

        <main class="checkout-main">

          <div class="checkout-section-header">

            <div>

              <p class="checkout-section-kicker">
                Votre sélection
              </p>

              <h2 class="checkout-section-title">
                Récapitulatif
              </h2>

            </div>

            <p class="checkout-section-count">
              <%= pluralize(
                @cart.cart_items.sum(&:quantity),
                "article"
              ) %>
            </p>

          </div>


          <!-- =================================================
               ITEMS
          ================================================== -->

          <div class="checkout-items">

            <% @cart.cart_items.each_with_index do |item, index| %>

              <%
                unit_price_ttc = item.product.price.to_f
                line_total_ttc = unit_price_ttc * item.quantity
              %>

              <article class="checkout-item">

                <!-- INDEX -->

                <span class="checkout-item__index">
                  <%= format("%02d", index + 1) %>
                </span>


                <!-- IMAGE -->

                <%= link_to(
                  product_path(item.product),
                  class: "checkout-item__media"
                ) do %>

                  <% if item.product.image_url.present? %>

                    <%= image_tag(
                      item.product.image_url,
                      alt: item.product.name,
                      class: "checkout-item__image",
                      loading: "lazy"
                    ) %>

                  <% else %>

                    <div
                      class="checkout-item__placeholder"
                      aria-hidden="true">
                    </div>

                  <% end %>

                <% end %>


                <!-- PRODUCT -->

                <div class="checkout-item__product">

                  <p class="checkout-item__category">
                    Maison Lumière
                  </p>

                  <h3 class="checkout-item__name">

                    <%= link_to(
                      item.product.name,
                      product_path(item.product)
                    ) %>

                  </h3>

                  <p class="checkout-item__meta">
                    Quantité
                    <span><%= item.quantity %></span>
                  </p>

                  <p class="checkout-item__unit">
                    <%= number_to_currency(
                      unit_price_ttc,
                      unit: "€",
                      format: "%n %u"
                    ) %>
                    TTC / unité
                  </p>

                </div>


                <!-- TOTAL -->

                <div class="checkout-item__total">

                  <span>
                    Total
                  </span>

                  <strong>
                    <%= number_to_currency(
                      line_total_ttc,
                      unit: "€",
                      format: "%n %u"
                    ) %>
                  </strong>

                  <small>
                    TTC
                  </small>

                </div>

              </article>

            <% end %>

          </div>


          <!-- =================================================
               INFORMATION
          ================================================== -->

          <div class="checkout-information">

            <span class="checkout-information__index">
              01
            </span>

            <div>

              <p class="checkout-information__kicker">
                Paiement sécurisé
              </p>

              <h2 class="checkout-information__title">
                Une dernière étape
              </h2>

              <p class="checkout-information__text">
                Après validation de votre sélection, vous accéderez
                à notre espace de paiement Maison Lumière.
                Les informations bancaires seront traitées de manière
                sécurisée par Stripe et ne transiteront pas par notre serveur.
              </p>

            </div>

          </div>


          <!-- =================================================
               BACK
          ================================================== -->

          <div class="checkout-back">

            <%= link_to(
              "← Modifier mon panier",
              cart_path(@cart),
              class: "checkout-back__link"
            ) %>

          </div>

        </main>


        <!-- ===================================================
             PAYMENT SUMMARY
        ==================================================== -->

        <aside class="checkout-summary">

          <div class="checkout-summary__header">

            <p class="checkout-summary__kicker">
              Votre commande
            </p>

            <h2 class="checkout-summary__title">
              Résumé
            </h2>

          </div>


          <!-- DETAILS -->

          <div class="checkout-summary__details">

            <div class="checkout-summary__row">

              <span>
                Articles
              </span>

              <strong>
                <%= @cart.cart_items.sum(:quantity) %>
              </strong>

            </div>


            <div class="checkout-summary__row">

              <span>
                Sous-total HT
              </span>

              <strong>
                <%= number_to_currency(
                  subtotal_ht,
                  unit: "€",
                  format: "%n %u"
                ) %>
              </strong>

            </div>


            <div class="checkout-summary__row">

              <span>
                TVA 20 %
              </span>

              <strong>
                <%= number_to_currency(
                  tva_total,
                  unit: "€",
                  format: "%n %u"
                ) %>
              </strong>

            </div>


            <div class="checkout-summary__row">

              <span>
                Livraison
              </span>

              <strong class="checkout-summary__delivery">
                Calculée séparément
              </strong>

            </div>

          </div>


          <!-- TOTAL -->

          <div class="checkout-summary__total">

            <div>

              <span>
                Total
              </span>

              <small>
                TTC
              </small>

            </div>

            <strong>
              <%= number_to_currency(
                total_ttc,
                unit: "€",
                format: "%n %u"
              ) %>
            </strong>

          </div>


          <p class="checkout-summary__tax">
            TVA 20 % incluse dans le montant total.
          </p>


          <!-- =================================================
               PAYMENT
          ================================================== -->

          <div class="checkout-payment">

            <p class="checkout-payment__label">
              Paiement sécurisé
            </p>

            <%= link_to(
              checkout_payment_path,
              class: "checkout-payment__button"
            ) do %>

              Procéder au paiement

            <% end %>


            <p class="checkout-payment__note">
              Vous accéderez à notre espace de paiement sécurisé.
              Le règlement sera traité par Stripe.
            </p>

          </div>


          <!-- =================================================
               REASSURANCE
          ================================================== -->

          <div class="checkout-reassurance">

            <div class="checkout-reassurance__item">

              <span>01</span>

              <div>
                <strong>Paiement sécurisé</strong>
                <p>Transaction traitée directement par Stripe</p>
              </div>

            </div>


            <div class="checkout-reassurance__item">

              <span>02</span>

              <div>
                <strong>Données protégées</strong>
                <p>Vos informations bancaires ne sont pas stockées par Maison Lumière</p>
              </div>

            </div>

          </div>

        </aside>

      </div>


    <% else %>

      <!-- =====================================================
           EMPTY
      ====================================================== -->

      <div class="checkout-empty">

        <p class="checkout-empty__kicker">
          Votre commande
        </p>

        <h2 class="checkout-empty__title">
          Votre panier est vide
        </h2>

        <p class="checkout-empty__text">
          Découvrez la collection Maison Lumière et sélectionnez
          les luminaires qui accompagneront votre intérieur.
        </p>

        <%= link_to(
          "Explorer la collection",
          products_path,
          class: "checkout-empty__button"
        ) %>

      </div>

    <% end %>

  </div>

</section>
